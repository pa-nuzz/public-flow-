# Core
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1



# --- IMPORTANT: ngrok/Cloudflare Tunnel Setup ---
# Every time you start ngrok, set these three variables to your HTTPS tunnel URL:
# Example: ngrok http 8000
# If your URL is https://YOUR-ID.ngrok-free.app, set:
# TRACKING_BASE_URL=https://YOUR-ID.ngrok-free.app
# CSRF_TRUSTED_ORIGINS=https://YOUR-ID.ngrok-free.app
# ALLOWED_HOSTS=localhost,127.0.0.1,YOUR-ID.ngrok-free.app

PUBLIC_BASE_URL=http://127.0.0.1:8000
TRACKING_BASE_URL=http://127.0.0.1:8000
NGROK_DOMAIN=
CSRF_TRUSTED_ORIGINS=

# Session / security toggles
FORCE_HTTPS=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Cache / Redis
CACHE_BACKEND=locmem
REDIS_CACHE_URL=redis://localhost:6379/0

# SMTP / email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_TIMEOUT=20

# App encryption
ENCRYPTION_KEY=
SMTP_ENCRYPTION_KEY=

# Optional DB (only if you switch from sqlite)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ML model paths (defaults already work)
ML_MODEL_PATH=models_ml/spam_model.pkl
ML_VECTORIZER_PATH=models_ml/tfidf_vectorizer.pkl

# Frontend/cache busting
STATIC_VERSION=1
SESSION_COOKIE_NAME=mailflow_session_v2
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
